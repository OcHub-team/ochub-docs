{
  // Cloudflare Workers static-assets config.
  //
  // GitHub Actions builds the site (including the Rust/WASM renderer) and
  // deploys the resulting `dist` directory after every successful main-branch
  // check. Cloudflare's repository integration stays disconnected so there is
  // only one deployment pipeline.
  //
  // The deploy command is a Workers command, so this file must describe a
  // Worker — `assets.directory` — and NOT `pages_build_output_dir`. Setting
  // the Pages key here makes wrangler warn that it's a Pages project and
  // then fail with "Missing entry-point to Worker script or to assets
  // directory", because a Worker deploy has nothing to upload.
  //
  // Serving static files needs no Worker script: with `assets` and no
  // `main`, Cloudflare serves the directory directly.
  //
  // That directness has a cost: Cloudflare types each file from its
  // extension and knows nothing of the `Content-Type` our endpoints set,
  // because a static build keeps only their bodies. `public/_headers`
  // puts the `charset=utf-8` back on the .md/.mdx/.txt responses.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ochub-docs",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./dist",
    // Astro emits dist/404.html; serve it for unmatched paths instead of
    // returning a bare 404 with no body.
    "not_found_handling": "404-page"
  }
}
