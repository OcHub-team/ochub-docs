---
type Locale = "en" | "zh" | "ja";

interface Props {
  scene: string;
  locale?: Locale;
  app?: string;
  currentName?: string;
  connectionName?: string;
  endpoint?: string;
  title: string;
  compact?: boolean;
}

const {
  scene,
  locale = "en",
  app = "Claude Code",
  currentName,
  connectionName,
  endpoint,
  title,
  compact = false,
} = Astro.props;

const query = new URLSearchParams({ scene, locale, app });
if (currentName) query.set("currentName", currentName);
if (connectionName) query.set("connectionName", connectionName);
if (endpoint) query.set("endpoint", endpoint);
// Use the concrete Trunk entry point. Astro's production preview resolves a
// directory URL such as `/wasm/`, but its development server treats that URL
// as a content route and returns the documentation 404 page instead.
const src = `/wasm/index.html?${query.toString()}`;
const copy = {
  en: { runtime: "Loading illustration", illustration: "Illustration · follow the steps in OcHub" },
  zh: { runtime: "正在加载示意图", illustration: "界面示意 · 请在 OcHub 中按步骤操作" },
  ja: { runtime: "図を読み込み中", illustration: "画面例 · 操作は OcHub で行ってください" },
} as const;
const t = copy[locale];
---

<div class:list={["wasm-scene", { "is-compact": compact, "is-tutorial": scene.startsWith("codex-guide-") }]} style={`--tutorial-height: ${["codex-guide-1", "codex-guide-6"].includes(scene) ? "28rem" : "23rem"}`} data-wasm-scene>
  <div class="wasm-scene-loading" aria-hidden="true">
    <span></span>
    <div>
      <strong>GPUI / WASM</strong>
      <small>{t.runtime}</small>
    </div>
  </div>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allow="webgpu"
    tabindex={scene.startsWith("codex-guide-") ? -1 : undefined}
    class:list={{ "is-illustration": scene.startsWith("codex-guide-") }}
    data-wasm-scene-frame
  ></iframe>
</div>
{scene.startsWith("codex-guide-") && <p class="illustration-label">{t.illustration}</p>}

<script>
  const bindWasmScenes = () => {
    document.querySelectorAll<HTMLElement>("[data-wasm-scene]").forEach((scene) => {
      if (scene.dataset.bound === "true") return;
      scene.dataset.bound = "true";
      const frame = scene.querySelector<HTMLIFrameElement>("[data-wasm-scene-frame]");
      frame?.addEventListener("load", () => scene.setAttribute("data-loaded", "true"), { once: true });
    });
  };
  bindWasmScenes();
  document.addEventListener("astro:page-load", bindWasmScenes);
</script>

<style>
  .wasm-scene {
    position: relative;
    width: 100%;
    min-height: clamp(30rem, 66vw, 44rem);
    overflow: hidden;
    border: 1px solid var(--nb-border-strong);
    border-radius: .75rem;
    background: var(--nb-muted);
    box-shadow: var(--nb-shadow-lg);
  }
  .wasm-scene.is-compact {
    min-height: clamp(24rem, 58vw, 34rem);
    border-radius: .55rem;
    box-shadow: var(--nb-shadow);
  }
  iframe {
    display: block;
    width: 100%;
    height: clamp(30rem, 66vw, 44rem);
    border: 0;
    background: #151613;
    opacity: 0;
    transition: opacity 220ms cubic-bezier(.25, 1, .5, 1);
  }
  .is-compact iframe { height: clamp(24rem, 58vw, 34rem); }
  .wasm-scene.is-tutorial { min-height: var(--tutorial-height); }
  .is-tutorial iframe { height: var(--tutorial-height); }
  [data-loaded="true"] iframe { opacity: 1; }
  .wasm-scene-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .75rem;
    color: var(--nb-muted-foreground);
    pointer-events: none;
    transition: opacity 150ms cubic-bezier(.7, 0, .84, 0);
  }
  [data-loaded="true"] .wasm-scene-loading { opacity: 0; }
  .wasm-scene-loading span {
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--nb-border-strong);
    border-top-color: var(--nb-primary);
    border-radius: 50%;
    animation: scene-spin 900ms linear infinite;
  }
  .wasm-scene-loading div { display: flex; flex-direction: column; }
  .wasm-scene-loading strong { color: var(--nb-foreground); font-family: var(--nb-font-mono); font-size: .72rem; letter-spacing: .08em; }
  .wasm-scene-loading small { font-size: .72rem; }
  iframe.is-illustration { pointer-events: none; }
  .illustration-label { margin: .5rem 0; color: var(--nb-muted-foreground); font-size: .75rem; }
  @keyframes scene-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    iframe, .wasm-scene-loading { transition: none; }
    .wasm-scene-loading span { animation-duration: 1.8s; }
  }
</style>
